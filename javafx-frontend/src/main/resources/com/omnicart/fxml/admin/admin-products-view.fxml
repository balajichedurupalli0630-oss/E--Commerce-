<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.admin.AdminProductsController"
      spacing="20">

    <!-- HEADER & ACTIONS BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="Products Catalogue" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <Label text="Manage inventory, prices, colors, sizes and categories" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <TextField fx:id="searchField" promptText="Filter products..." prefWidth="240" styleClass="text-field"/>
        <Button fx:id="addProductBtn" text="Add Product" onAction="#onAddProduct" styleClass="btn-primary-dark"/>
    </HBox>

    <!-- PRODUCTS TABLE -->
    <TableView fx:id="productsTable" prefHeight="580" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="selectColumn" text="" prefWidth="40" resizable="false"/>
            <TableColumn fx:id="imageColumn" text="IMAGE" prefWidth="70" resizable="false"/>
            <TableColumn fx:id="nameColumn" text="PRODUCT NAME" prefWidth="220"/>
            <TableColumn fx:id="priceColumn" text="PRICE" prefWidth="120"/>
            <TableColumn fx:id="descColumn" text="DESCRIPTION" prefWidth="380"/>
            <TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="130" resizable="false"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
