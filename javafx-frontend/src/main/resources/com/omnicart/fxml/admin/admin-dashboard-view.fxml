<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.admin.AdminDashboardController"
      spacing="24">

    <!-- TOP SECTION: REVENUE CHART & LATEST TRANSACTIONS -->
    <HBox spacing="20">
        <!-- TOTAL REVENUE BAR CHART -->
        <VBox styleClass="admin-card" HBox.hgrow="ALWAYS" prefHeight="340">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Monthly Revenue &amp; Orders" styleClass="admin-card-header"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalRevenueLabel" text="Total: ₹0.00" styleClass="badge-info"/>
                <Label fx:id="totalOrdersCountLabel" text="0 Orders" styleClass="badge-neutral"/>
            </HBox>
            <BarChart fx:id="revenueBarChart" animated="false" legendVisible="true" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis fx:id="revenueXAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="revenueYAxis" label="Revenue (₹)"/>
                </yAxis>
            </BarChart>
        </VBox>

        <!-- LATEST TRANSACTIONS -->
        <VBox styleClass="admin-card" prefWidth="380" spacing="14">
            <Label text="Latest Transactions" styleClass="admin-card-header"/>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefHeight="260">
                <VBox fx:id="latestTransactionsList" spacing="10"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- MIDDLE SECTION: TODO LIST & POPULAR PRODUCTS -->
    <HBox spacing="20">
        <!-- TODO LIST -->
        <VBox styleClass="admin-card" HBox.hgrow="ALWAYS" spacing="14" prefHeight="320">
            <HBox alignment="CENTER_LEFT">
                <Label text="Operational Tasks" styleClass="admin-card-header"/>
                <Region HBox.hgrow="ALWAYS"/>
                <DatePicker fx:id="todoDatePicker" prefWidth="160"/>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="todoItemsBox" spacing="10"/>
            </ScrollPane>
        </VBox>

        <!-- POPULAR PRODUCTS -->
        <VBox styleClass="admin-card" prefWidth="380" spacing="14" prefHeight="320">
            <Label text="Popular Products" styleClass="admin-card-header"/>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefHeight="260">
                <VBox fx:id="popularProductsList" spacing="10"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- PRODUCT RESTOCK & PRICING ADVICE -->
    <VBox spacing="12" styleClass="admin-card dashboard-card">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Product Restock &amp; Pricing Advice" styleClass="admin-card-header section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="highConfidenceCountLabel" text="0 Actionable Insights" styleClass="badge-info"/>
            <Button text="Refresh Analysis" onAction="#loadFinancialInsights" styleClass="btn-secondary"/>
        </HBox>

        <TableView fx:id="recommendationsTable" prefHeight="340">
            <columns>
                <TableColumn fx:id="colProduct" text="Product" prefWidth="160"/>
                <TableColumn fx:id="colCostAndPrice" text="Cost → Price (Margin)" prefWidth="165"/>
                <TableColumn fx:id="colDemandCi" text="Est. Daily Sales" prefWidth="130"/>
                <TableColumn fx:id="colConfidence" text="Confidence" prefWidth="95"/>
                <TableColumn fx:id="colPricingAdvice" text="Recommended Price" prefWidth="220"/>
                <TableColumn fx:id="colInventoryAdvice" text="Stock &amp; Restock Advice" prefWidth="250"/>
                <TableColumn fx:id="colQuickAction" text="Quick Action" prefWidth="140"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
