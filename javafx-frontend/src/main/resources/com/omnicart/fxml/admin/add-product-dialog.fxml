<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.admin.AddProductDialogController"
      prefWidth="520" prefHeight="650" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 24px;">

    <Label text="Add New Product" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="14" style="-fx-padding: 4px 6px;">
            <VBox spacing="4">
                <Label text="Product Name *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextField fx:id="nameField" promptText="e.g. Nike Air Max Pullover"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Short Description *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextField fx:id="shortDescField" promptText="Brief summary for product card"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Full Description" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextArea fx:id="descField" promptText="Detailed specifications and material..." prefRowCount="3"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Price (INR) *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <TextField fx:id="priceField" promptText="e.g. 2999.00"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Category *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="categoryComboBox" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Available Sizes" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <FlowPane fx:id="sizesPane" hgap="12" vgap="8"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Available Colors" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <FlowPane fx:id="colorsPane" hgap="12" vgap="8"/>
            </VBox>

            <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
        </VBox>
    </ScrollPane>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8px 0 0 0;">
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-secondary-outline"/>
        <Button fx:id="saveBtn" text="Save Product" onAction="#onSave" styleClass="btn-primary-dark"/>
    </HBox>

</VBox>
