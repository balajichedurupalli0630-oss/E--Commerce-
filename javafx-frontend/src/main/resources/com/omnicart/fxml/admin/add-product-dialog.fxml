<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.admin.AddProductDialogController"
      prefWidth="540" prefHeight="700" spacing="16" style="-fx-background-color: #ffffff; -fx-padding: 24px;">

    <Label text="Add New Product" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="14" style="-fx-padding: 4px 6px;">
            <VBox spacing="4">
                <Label text="Product Name *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextField fx:id="nameField" promptText="e.g. Nike Air Max Pullover"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Short Description *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextField fx:id="shortDescField" promptText="Brief summary for product card"/>
            </VBox>

            <VBox spacing="4">
                <Label text="Full Description" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <TextArea fx:id="descField" promptText="Detailed specifications and material..." prefRowCount="3"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Product Image *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="imageField" promptText="/products/1g.png or http://... or select file" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="browseImageBtn" text="Browse..." onAction="#onBrowseImage" styleClass="btn-secondary-outline"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane style="-fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-background-color: #f8fafc; -fx-padding: 4px; -fx-min-width: 68px; -fx-min-height: 68px; -fx-max-width: 68px; -fx-max-height: 68px;" alignment="CENTER">
                        <ImageView fx:id="imagePreview" fitHeight="60" fitWidth="60" preserveRatio="true"/>
                    </StackPane>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Accepted: PNG, JPG, JPEG, WEBP or web image URL." style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Samples:" style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                            <Button text="1g.png" onAction="#onSelectSample1" style="-fx-font-size: 10px; -fx-padding: 2px 6px; -fx-cursor: hand;"/>
                            <Button text="2g.png" onAction="#onSelectSample2" style="-fx-font-size: 10px; -fx-padding: 2px 6px; -fx-cursor: hand;"/>
                            <Button text="8b.png" onAction="#onSelectSample3" style="-fx-font-size: 10px; -fx-padding: 2px 6px; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Selling Price (INR) *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <TextField fx:id="priceField" promptText="e.g. 2999.00"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Buying Cost (INR) *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <TextField fx:id="costPriceField" promptText="e.g. 1500.00"/>
                </VBox>
            </HBox>

            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Initial Stock *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <TextField fx:id="stockQuantityField" promptText="e.g. 50"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Supplier Lead Time (Days)" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <TextField fx:id="leadTimeField" promptText="Default: 5"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Category *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="categoryComboBox" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label fx:id="sizesLabel" text="Available Sizes" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <FlowPane fx:id="sizesPane" hgap="12" vgap="8"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Available Colors" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <FlowPane fx:id="colorsPane" hgap="12" vgap="8"/>
            </VBox>

            <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
        </VBox>
    </ScrollPane>

    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8px 0 0 0;">
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-secondary-outline"/>
        <Button fx:id="saveBtn" text="Save Product" onAction="#onSave" styleClass="btn-primary-dark"/>
    </HBox>

</VBox>
