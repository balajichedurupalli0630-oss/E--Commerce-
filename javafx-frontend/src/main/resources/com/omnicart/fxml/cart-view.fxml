<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.CartController"
      spacing="32" alignment="TOP_CENTER" style="-fx-padding: 20px 0;">

    <!-- TITLE -->
    <Label text="Your Shopping Cart" style="-fx-font-size: 24px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>

    <!-- STEP WIZARD BREADCRUMB -->
    <HBox spacing="40" alignment="CENTER">
        <!-- STEP 1 -->
        <HBox fx:id="step1Indicator" spacing="10" alignment="CENTER" styleClass="wizard-step-box">
            <Label fx:id="step1Circle" text="1" styleClass="step-circle-active"/>
            <Label text="Shopping Cart" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1f2937;"/>
        </HBox>

        <!-- STEP 2 -->
        <HBox fx:id="step2Indicator" spacing="10" alignment="CENTER" styleClass="wizard-step-box">
            <Label fx:id="step2Circle" text="2" styleClass="step-circle-inactive"/>
            <Label text="Shipping Address" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #9ca3af;"/>
        </HBox>

        <!-- STEP 3 -->
        <HBox fx:id="step3Indicator" spacing="10" alignment="CENTER" styleClass="wizard-step-box">
            <Label fx:id="step3Circle" text="3" styleClass="step-circle-inactive"/>
            <Label text="Payment Method" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #9ca3af;"/>
        </HBox>
    </HBox>

    <!-- CONTENT COLUMNS: LEFT PANELS & RIGHT SUMMARY -->
    <HBox spacing="36" alignment="TOP_CENTER">

        <!-- LEFT PANEL: STEPS 1, 2, 3 -->
        <VBox prefWidth="640" spacing="20">

            <!-- STEP 1 PANEL: CART ITEMS -->
            <VBox fx:id="step1Panel" spacing="16" styleClass="cart-card-container">
                <Label text="Items in Your Cart" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                <Label fx:id="emptyCartLabel" text="Your cart is currently empty." visible="false" managed="false"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 14px; -fx-padding: 20px 0;"/>
                <VBox fx:id="cartItemsList" spacing="12"/>
            </VBox>

            <!-- STEP 2 PANEL: SHIPPING FORM -->
            <VBox fx:id="step2Panel" spacing="16" styleClass="cart-card-container" visible="false" managed="false">
                <Label text="Shipping Address" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>

                <VBox spacing="4">
                    <Label text="Full Name" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="nameField" promptText="John Doe"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Email Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="emailField" promptText="johndoe@gmail.com"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Phone Number" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="phoneField" promptText="+1 234 567 8900"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Street Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="addressField" promptText="123 Main Street, Suite 4B"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="City" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="cityField" promptText="New York"/>
                </VBox>

                <Label fx:id="shippingErrorLabel" text="" visible="false"
                       style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>

                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
                    <Button text="← Back to Cart" onAction="#onBackToStep1" styleClass="btn-secondary-outline"/>
                    <Button text="Continue to Payment →" onAction="#onContinueToStep3" styleClass="btn-primary-dark"/>
                </HBox>
            </VBox>

            <!-- STEP 3 PANEL: PAYMENT -->
            <VBox fx:id="step3Panel" spacing="20" styleClass="cart-card-container" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Payment Confirmation" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="🛡 Test Mode Active" style="-fx-background-color: #ecfdf5; -fx-text-fill: #047857; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 3px 8px; -fx-background-radius: 12px;"/>
                </HBox>

                <!-- DELIVERY SUMMARY -->
                <VBox spacing="6" style="-fx-background-color: #f9fafb; -fx-padding: 14px; -fx-background-radius: 8px;">
                    <Label text="Delivery Address:" style="-fx-font-weight: 600; -fx-font-size: 13px; -fx-text-fill: #111827;"/>
                    <Label fx:id="deliveryNameLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>
                    <Label fx:id="deliveryAddressLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>
                    <Label fx:id="deliveryPhoneLabel" text="" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                </VBox>

                <!-- PAYABLE AMOUNT -->
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f9fafb; -fx-padding: 14px; -fx-background-radius: 8px;">
                    <VBox spacing="2">
                        <Label text="Total Payable Amount" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="paymentTotalLabel" text="₹0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="paymentItemsCountLabel" text="0 items" style="-fx-font-size: 13px; -fx-text-fill: #4b5563; -fx-font-weight: 500;"/>
                </HBox>

                <ProgressIndicator fx:id="paymentProgress" visible="false" prefWidth="24" prefHeight="24"/>

                <!-- ACTION BUTTONS -->
                <VBox spacing="10">
                    <Button fx:id="placeOrderBtn" text="Place Order (₹0.00)" onAction="#onPlaceOrder"
                            maxWidth="Infinity" styleClass="btn-primary-dark" prefHeight="44"/>
                    <Button fx:id="payWithStripeBtn" text="Pay via Stripe Hosted Checkout" onAction="#onPayWithStripe"
                            maxWidth="Infinity" styleClass="btn-secondary-outline" prefHeight="40"/>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <Button text="← Back to Shipping Form" onAction="#onBackToStep2"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-underline: true; -fx-cursor: hand;"/>
                </HBox>

                <Label text="Orders placed are published to Apache Kafka, recorded in MongoDB, and will immediately show up in your Orders History and the Admin Portal."
                       wrapText="true" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-alignment: center;"/>
            </VBox>

        </VBox>

        <!-- RIGHT PANEL: CART DETAILS SUMMARY -->
        <VBox prefWidth="360" spacing="18" styleClass="cart-card-container" maxHeight="340">
            <Label text="Cart Details" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>

            <VBox spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Subtotal" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="subtotalLabel" text="₹0.00" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #111827;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Discount(10%)" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="discountLabel" text="₹0.00" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #111827;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Shipping Fee" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="shippingFeeLabel" text="₹0.00" style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #111827;"/>
                </HBox>

                <Separator/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Total" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="₹0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </HBox>
            </VBox>

            <Button fx:id="continueToStep2Btn" text="Continue to Shipping" onAction="#onContinueToStep2"
                    maxWidth="Infinity" styleClass="btn-primary-dark" prefHeight="42"/>
        </VBox>

    </HBox>

</VBox>
