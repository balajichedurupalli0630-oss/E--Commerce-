<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnicart.controller.HomeController"
      spacing="28" alignment="TOP_CENTER">

    <!-- HERO FEATURED BANNER -->
    <StackPane styleClass="hero-banner-container" maxHeight="320">
        <ImageView fx:id="heroBannerImageView" fitWidth="1100" fitHeight="320" preserveRatio="true"/>
    </StackPane>

    <!-- CATEGORIES BAR -->
    <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;">
        <HBox fx:id="categoriesBox" alignment="CENTER_LEFT" spacing="8" styleClass="categories-container"/>
    </ScrollPane>

    <!-- LOADING BOX -->
    <VBox fx:id="loadingBox" alignment="CENTER" spacing="12" prefHeight="200" visible="false" managed="false">
        <ProgressIndicator prefWidth="36" prefHeight="36"/>
        <Label text="Fetching latest products..." style="-fx-text-fill: #6b7280; -fx-font-size: 13px;"/>
    </VBox>

    <!-- STATUS / EMPTY MESSAGE -->
    <Label fx:id="statusLabel" visible="false" style="-fx-text-fill: #6b7280; -fx-font-size: 14px; -fx-padding: 30px;"/>

    <!-- PRODUCT GRID -->
    <FlowPane fx:id="productsGrid" hgap="24" vgap="28" alignment="TOP_CENTER" prefWrapLength="1100"/>

    <!-- VIEW ALL PRODUCTS LINK -->
    <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10px 0;">
        <Button text="View all products →" onAction="#onViewAllProductsClicked"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-size: 14px; -fx-underline: true; -fx-cursor: hand;"/>
    </HBox>

</VBox>
