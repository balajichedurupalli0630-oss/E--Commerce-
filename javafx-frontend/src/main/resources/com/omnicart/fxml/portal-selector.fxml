<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.omnicart.controller.PortalSelectorController"
           prefWidth="880" prefHeight="560"
           style="-fx-background-color: #f9fafb;">

    <VBox alignment="CENTER" spacing="0">

        <!-- HEADER -->
        <VBox alignment="CENTER" spacing="8"
              style="-fx-padding: 40px 0 32px 0;">
            <HBox alignment="CENTER" spacing="10">
                <ImageView fx:id="logoImage" fitWidth="44" fitHeight="44" preserveRatio="true"/>
                <Label text="OMNICART." style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            </HBox>
            <Label text="Choose your portal to get started"
                   style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <!-- PORTAL CARDS ROW -->
        <HBox alignment="CENTER" spacing="24" style="-fx-padding: 0 48px 0 48px;">

            <!-- CUSTOMER CARD -->
            <VBox fx:id="customerCard" alignment="CENTER" spacing="20"
                  prefWidth="340" prefHeight="300"
                  styleClass="portal-card"
                  onMouseClicked="#onCustomerPortalClicked"
                  onMouseEntered="#onCustomerCardHover"
                  onMouseExited="#onCustomerCardExit"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 16px;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-border-width: 2px;
                         -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                <!-- Icon -->
                <StackPane>
                    <VBox alignment="CENTER"
                          style="-fx-background-color: #f0fdf4; -fx-background-radius: 50%;
                                 -fx-min-width: 80px; -fx-min-height: 80px; -fx-max-width: 80px; -fx-max-height: 80px;">
                        <Label text="🛍" style="-fx-font-size: 36px;"/>
                    </VBox>
                </StackPane>

                <VBox alignment="CENTER" spacing="6">
                    <Label text="Customer Portal"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Browse products, place orders"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    <Label text="and track your deliveries"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </VBox>

                <Button text="Enter as Customer →"
                        onAction="#onCustomerPortalClicked"
                        style="-fx-background-color: #111827; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: 600;
                               -fx-background-radius: 8px; -fx-padding: 10px 24px;
                               -fx-cursor: hand;"/>
            </VBox>

            <!-- DIVIDER -->
            <VBox alignment="CENTER" spacing="8">
                <Rectangle width="1" height="100" style="-fx-fill: #e5e7eb;"/>
                <Label text="OR" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #9ca3af;"/>
                <Rectangle width="1" height="100" style="-fx-fill: #e5e7eb;"/>
            </VBox>

            <!-- ADMIN CARD -->
            <VBox fx:id="adminCard" alignment="CENTER" spacing="20"
                  prefWidth="340" prefHeight="300"
                  onMouseClicked="#onAdminCardClicked"
                  onMouseEntered="#onAdminCardHover"
                  onMouseExited="#onAdminCardExit"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 16px;
                         -fx-border-color: #e5e7eb; -fx-border-radius: 16px; -fx-border-width: 2px;
                         -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 12, 0, 0, 4);">

                <!-- Normal state -->
                <StackPane fx:id="adminNormalPane">
                    <VBox alignment="CENTER" spacing="20">
                        <!-- Icon -->
                        <StackPane>
                            <VBox alignment="CENTER"
                                  style="-fx-background-color: #faf5ff; -fx-background-radius: 50%;
                                         -fx-min-width: 80px; -fx-min-height: 80px; -fx-max-width: 80px; -fx-max-height: 80px;">
                                <Label text="⚙" style="-fx-font-size: 36px;"/>
                            </VBox>
                        </StackPane>

                        <VBox alignment="CENTER" spacing="6">
                            <Label text="Admin Portal"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label text="Manage products, orders,"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label text="users and analytics"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        </VBox>

                        <Button text="Enter as Admin →"
                                onAction="#onAdminCardClicked"
                                style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-font-weight: 600;
                                       -fx-background-radius: 8px; -fx-padding: 10px 24px;
                                       -fx-cursor: hand;"/>
                    </VBox>
                </StackPane>

                <!-- Password input state (hidden by default) -->
                <StackPane fx:id="adminLoginPane" visible="false" managed="false">
                    <VBox alignment="CENTER" spacing="14" style="-fx-padding: 10px 20px;">
                        <Label text="🔐 Admin Login"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                        <VBox spacing="4">
                            <Label text="Username"
                                   style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <TextField fx:id="adminUsernameField" promptText="admin"
                                       style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db;
                                              -fx-border-radius: 8px; -fx-background-radius: 8px;
                                              -fx-padding: 8px 12px; -fx-font-size: 13px;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Password"
                                   style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #4b5563;"/>
                            <PasswordField fx:id="adminPasswordField" promptText="••••••••"
                                           style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db;
                                                  -fx-border-radius: 8px; -fx-background-radius: 8px;
                                                  -fx-padding: 8px 12px; -fx-font-size: 13px;"/>
                        </VBox>

                        <Label fx:id="adminErrorLabel" text="" visible="false"
                               style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

                        <HBox spacing="8" alignment="CENTER">
                            <Button text="Cancel" onAction="#onAdminLoginCancel"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151;
                                           -fx-font-size: 12px; -fx-background-radius: 8px;
                                           -fx-padding: 8px 20px; -fx-cursor: hand;"/>
                            <Button fx:id="adminLoginBtn" text="Sign In" onAction="#onAdminLoginSubmit"
                                    style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                           -fx-font-size: 12px; -fx-font-weight: 600;
                                           -fx-background-radius: 8px; -fx-padding: 8px 20px;
                                           -fx-cursor: hand;"/>
                        </HBox>

                        <Label text="Demo: admin / admin123"
                               style="-fx-font-size: 10px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </StackPane>

            </VBox>
        </HBox>

        <!-- FOOTER NOTE -->
        <Label text="© 2026 OmniCart. All rights reserved."
               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-padding: 32px 0 0 0;"/>

    </VBox>
</StackPane>

